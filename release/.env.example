# Copy to .env (never commit it); run_all.sh reads it.

# Hugging Face read token: higher rate limits for `cdm prefetch`, and access to gated models.
HF_TOKEN=
# TypeSafe API key for Jev (src/cdm/rerankers/system_one.py also accepts TYPESAFE_AI_API_KEY).
TYPESAFE_API_KEY=
# Optional: Jev through OpenRouter instead (JEV_PROVIDER=openrouter; same model and price).
OPENROUTER_API_KEY=
JEV_PROVIDER=
