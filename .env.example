# Copy to .env (gitignored) and fill in. cluster/sync.sh copies .env to the cluster (mode 600) and slurm/env.sh
# passes every KEY=value line into the container.

# Hugging Face read token: higher rate limits for slurm/prefetch.sh, and access to gated models.
HF_TOKEN=
# TypeSafe API key for Jev (src/cdm/rerankers/system_one.py also accepts TYPESAFE_API_KEY, the SDK's name).
TYPESAFE_AI_API_KEY=
