# Secrets (HF_TOKEN, API keys) -- see .env.example
.env

# Large artifacts on /shared, next to the code; snapshots/ holds the code of each submission (slurm/snapshot.sh)
container/*.sif
container/*.sif.new
data/
runs/
outputs/
logs/
checkpoints/
snapshots/

# results/ IS tracked (results.csv, tables); only its lock files are not
results/*.lock
results/*.tmp

# Python
__pycache__/
*.pyc
*.egg-info/
.pytest_cache/
.venv/
poetry.lock

# Editors
.vscode/
.idea/

# LaTeX build files (paper/)
paper/*.aux
paper/*.bbl
paper/*.blg
paper/*.fdb_latexmk
paper/*.fls
paper/*.log
paper/*.out
paper/*.synctex.gz
paper/*.run.xml
paper/main.pdf

# Personal Claude Code settings
.claude/settings.local.json
