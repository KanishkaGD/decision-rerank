# Add to ~/.ssh/config on your own machine (replace <cluster-user>). cluster/*.sh connect to the alias "faith"
# (CLUSTER_HOST in cluster/cluster.env). Reachable only from the university network: office, Eduroam or EduVPN.
#
# FAITH accepts only password or Kerberos logins (no SSH keys), so connections are shared: the first one asks for
# the password, all later ones -- including every cluster/*.sh call -- reuse it. cluster/connect.sh opens it.
# Docs: https://faith.pages.fim.uni-passau.de/public-docs/slurm/

Host faith
    HostName freia.fim.uni-passau.de
    # Alternative, identical login node: frigga.fim.uni-passau.de
    User <cluster-user>
    ControlMaster auto
    ControlPath ~/.ssh/cm/%r@%h:%p
    ControlPersist 12h
    # With a Kerberos ticket (kinit <user>@<REALM>), no password prompt at all:
    GSSAPIAuthentication yes
    # Log in with the ticket, but do not forward it to the cluster (FIM advice on ssh -K).
    GSSAPIDelegateCredentials no

# Also trust the cluster's host certificate authority, so the first connection doesn't ask to confirm a host
# key: copy the `@cert-authority freia.fim.uni-passau.de,frigga.fim.uni-passau.de ...` line from the docs page
# above into ~/.ssh/known_hosts. Then: mkdir -p ~/.ssh/cm && chmod 700 ~/.ssh/cm
