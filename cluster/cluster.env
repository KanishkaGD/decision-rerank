# Cluster connection settings for the cluster/*.sh wrappers, which run on your own machine and reach the FAITH
# Slurm cluster's login node over SSH (https://faith.pages.fim.uni-passau.de/public-docs/slurm/).
# Sourced by cluster/lib.sh, not run directly. To change a value for your machine only, put it in
# cluster/cluster.local.env (gitignored), which is sourced after this file.

# SSH host alias from ~/.ssh/config (see cluster/ssh_config.example). freia and frigga are identical login nodes.
CLUSTER_HOST="${CLUSTER_HOST:-faith}"

# Project directory name under /shared/<cluster-user>/ on the cluster. /shared is the Ceph file system that both
# login and compute nodes see; /home on the cluster is login-node only, so jobs can't use it.
PROJECT_NAME="${PROJECT_NAME:-calibrated-decision-models-for-ir}"

# Remote repo root. Empty: derived as /shared/<cluster-user>/${PROJECT_NAME} by asking the cluster for the user
# name (one extra call over the shared connection, cached in cluster/.remote_root).
REMOTE_ROOT="${REMOTE_ROOT:-}"

# How long the shared SSH connection stays open after the last command (ssh's ControlPersist).
CONTROL_PERSIST="${CONTROL_PERSIST:-12h}"
