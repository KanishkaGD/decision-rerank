Bootstrap: docker
From: python:3.12-slim-trixie

# A second, small image for the Set-Encoder rerankers (src/cdm/rerankers/set_encoder.py): lightning-ir needs
# transformers < 5, while the main image (cdm.def) needs transformers >= 5.17 for Laya, Clef and Kev. It holds only
# what `cdm rerank` needs (no Pyserini, Java or System One packages); slurm/config.sh container_for picks it.
# Build: bash container/build.sh lightning-ir

%files
    pyproject.toml /opt/cdm/pyproject.toml
    README.md /opt/cdm/README.md
    src /opt/cdm/src

%post
    export DEBIAN_FRONTEND=noninteractive
    apt-get update
    apt-get install -y --no-install-recommends git
    rm -rf /var/lib/apt/lists/*

    pip install --no-cache-dir --upgrade pip
    # transformers < 5 explicitly: the PyPI release lightning-ir 0.0.6 only asks for >= 4.50 (the < 5 pin came later,
    # on its main branch), and a first build here resolved 5.19. The rest is what cdm's rerank path imports.
    pip install --no-cache-dir "lightning-ir==0.0.6" "transformers[torch]>=4.50,<5" "click>=8.1" "numpy>=1.26" \
        "pandas>=2.2" "scipy>=1.12" "ir-measures>=0.3.7"
    # The package itself only for the `cdm` entry point (the code comes from src/ via PYTHONPATH at run time);
    # --no-deps, since its full dependency list (laya, Kev's transformers) is what this image avoids.
    pip install --no-cache-dir --no-deps /opt/cdm
    pip freeze > /opt/cdm/pip-freeze.txt

%environment
    export PYTHONUNBUFFERED=1
    export LC_ALL=C.UTF-8
    export LANG=C.UTF-8
    export CDM_PIP_FREEZE=/opt/cdm/pip-freeze.txt

%runscript
    exec cdm "$@"

%labels
    Author michi_d@gmx.net
    Project calibrated-decision-models-for-ir (Set-Encoder image)
